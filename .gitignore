# Outputs we *do* want to commit:
#   - outputs/results.csv (the rolling leaderboard)
#   - outputs/pred_xx.csv (final deliverable)
# Anything else under outputs/ is local only.
outputs/*
!outputs/.gitkeep
!outputs/results.csv
!outputs/pred_xx.csv

# --- Secrets --------------------------------------------------------------
.env
.env.local
*.key
*.pem
