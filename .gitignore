# --- Project artefacts ----------------------------------------------------
# Raw data — drop train.csv / test.csv here locally, do not commit
data/*.csv

# Trained model checkpoints
*.pt
*.bin
*.safetensors
*.ckpt
*.pkl
*.joblib
models/

# Logs and HF cache
*.log
logs/
wandb/
.cache/huggingface/
